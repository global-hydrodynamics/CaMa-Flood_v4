#==========================================================
# CaMa-Flood Mkinclude (for MaxOSX, gfortran)
#==========================================================
RM = /bin/rm -f
CP = /bin/cp

#======================================
# Pre-Prosessing options
# DMPI=-DUseMPI_CMF        : activate MPI parallelization
# DCDF=-DUseCDF_CMF        : activate netCDF, comment out when not needed
# DSINGLE=-DSinglePrec_CMF : activate Single Precision Mode
# DATM=-DNoAtom_CMF        : avoid OMP ATOMIC calculation (bit identical simulation)
#======================================
DCDF=-DUseCDF_CMF
#DMPI=-DUseMPI_CMF
#DSINGLE=-DSinglePrec_CMF
#DATM=-DNoAtom_CMF
#======================================
DHEATLINK=-Dheatlink

CFLAGS=$(DMPI) $(DCDF) $(DATM) $(DSINGLE) $(DHEATLINK)

#======================================
# extensions
#EXT_LIBS =
EXT_LIBS = common mod phys io heatlink
EXT_LIB_TARGETS := $(foreach d,$(EXT_LIBS),$(d)/lib$(notdir $(d)).a)

#======================================
# GNU Fortran and netCDF from one conda toolchain
TOOLCHAIN_ROOT ?= $(CONDA_PREFIX)
ifeq ($(strip $(TOOLCHAIN_ROOT)),)
  $(error TOOLCHAIN_ROOT is not set. Activate conda environment ils or use gosh/compile_heatlink.sh)
endif

NF_CONFIG ?= $(TOOLCHAIN_ROOT)/bin/nf-config
ifeq ($(wildcard $(NF_CONFIG)),)
  $(error nf-config was not found at $(NF_CONFIG))
endif

NETCDF_FC     := $(shell $(NF_CONFIG) --fc)
NETCDF_FFLAGS := $(shell $(NF_CONFIG) --fflags)
NETCDF_FLIBS  := $(shell $(NF_CONFIG) --flibs)
NETCDFDIR     := $(TOOLCHAIN_ROOT)

# INC and LIB are retained for extension-library Makefiles.
INC = $(NETCDF_FFLAGS)
LIB = $(NETCDF_FLIBS)

# FCMP: main program (src/), FC: extension libraries and preprocessing tools.
FCMP ?= $(NETCDF_FC)
FC = $(FCMP)
DBGFLAGS   := -g -fbacktrace -fcheck=all -ffpe-trap=invalid,zero,overflow -finit-real=nan -finit-integer=-999999
WARNFLAGS  := -Wextra -Wimplicit-interface -Wsurprising -Waliasing -Wampersand -Wunderflow -Wconversion -Wno-compare-reals
BASEFLAGS  := $(WARNFLAGS) -Wall -ffree-line-length-none -fimplicit-none -ftree-vectorize
BUILD_MODE ?= debug
LFLAGS :=
# --- sanitize external env flags (conda etc.) ---
# Do NOT inherit environment LDFLAGS to avoid duplicate LC_RPATH on macOS
override LDFLAGS :=
ifeq ($(BUILD_MODE),debug)
  FFLAGS := -O0 $(BASEFLAGS) $(DBGFLAGS)
  LFLAGS += $(DBGFLAGS)
else ifeq ($(BUILD_MODE),release)
  FFLAGS := -O3 $(BASEFLAGS)
else
  $(error BUILD_MODE must be either debug or release)
endif
LIBS   := $(NETCDF_FLIBS)

OPENMP := -fopenmp
FFLAGS += $(OPENMP)
LFLAGS += $(OPENMP)

ifeq ($(findstring gfortran,$(FC)),gfortran)
  FPPFLAG   ?= -cpp
  FCMODFLAG  = -J
else ifneq (,$(filter ifort ifx,$(FC)))
  FPPFLAG   ?= -fpp
  FCMODFLAG  = -module
else
  FPPFLAG   ?=
  FCMODFLAG  =
endif

#==============================
PROJ_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
SRC_ROOT  := $(PROJ_ROOT)/src

#==============================
inc = $(if $(wildcard $1),-I$1)

INCDIRS := \
  $(call inc,$(SRC_ROOT)) \
  $(foreach d,$(EXT_LIBS),$(call inc,$(SRC_ROOT)/$(d))) \
  $(NETCDF_FFLAGS)

%.o %.mod: %.f90
	$(FC) $(FFLAGS) $(FPPFLAG) $(FCMODFLAG) $(@D) -c $(INCDIRS) $(CFLAGS) $< -o $*.o

%.o %.mod: %.F90
	$(FC) $(FFLAGS) $(FPPFLAG) $(FCMODFLAG) $(@D) -c $(INCDIRS) $(CFLAGS) $< -o $*.o

define MAKE_IN_DIR
	@echo "==> make -C $(1) $(2)"
	@$(MAKE) -C $(1) $(2)
endef
