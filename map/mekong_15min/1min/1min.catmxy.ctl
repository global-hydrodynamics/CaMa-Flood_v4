dset ^1min.catmxy.bin
undef -9999
title CaMa-Flood map file 1min.catmxy.bin
options yrev little_endian
xdef 1200 linear 90.0083333333 0.0166666666667
ydef 1800 linear 5.00833333333 0.0166666666667
tdef 1 linear 00Z01jan2000 1yr
zdef 1 linear 1 1
vars 2
catmxx 1 -1,40,2,-1 Regional high-resolution catchment x/y indices [1]
catmyy 1 -1,40,2,-1 Regional high-resolution catchment x/y indices [1]
ENDVARS
