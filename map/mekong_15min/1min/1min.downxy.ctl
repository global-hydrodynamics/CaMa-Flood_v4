dset ^1min.downxy.bin
undef -9999
title CaMa-Flood map file 1min.downxy.bin
options yrev little_endian
xdef 1200 linear 90.0083333333 0.0166666666667
ydef 1800 linear 5.00833333333 0.0166666666667
tdef 1 linear 00Z01jan2000 1yr
zdef 1 linear 1 1
vars 2
downx 1 -1,40,2,-1 High-resolution downstream x offset [grid cells]
downy 1 -1,40,2,-1 High-resolution downstream y offset [grid cells]
ENDVARS
