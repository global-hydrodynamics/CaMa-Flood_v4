ydef 1800 linear 5.00833333333 0.0166666666667
tdef 1 linear 00Z01jan2000 1yr
zdef 1 linear 1 1
vars 1
grdare_hires 1 99 High-resolution pixel area layer [km2 as assumed by generate_inpmat]
ENDVARS
