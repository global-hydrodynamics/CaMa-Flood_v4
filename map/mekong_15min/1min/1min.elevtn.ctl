dset ^1min.elevtn.bin
undef -9999
title CaMa-Flood map file 1min.elevtn.bin
options yrev little_endian
xdef 1200 linear 90.0083333333 0.0166666666667
ydef 1800 linear 5.00833333333 0.0166666666667
tdef 1 linear 00Z01jan2000 1yr
zdef 1 linear 1 1
vars 1
elevtn 1 99 High-resolution elevation layer [m]
ENDVARS
