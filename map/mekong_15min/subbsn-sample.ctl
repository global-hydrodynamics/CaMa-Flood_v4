dset ^subbsn-sample.bin
undef -9999
title CaMa-Flood map file subbsn-sample.bin
options yrev little_endian
xdef 80 linear 90.125 0.25
ydef 120 linear 5.125 0.25
tdef 1 linear 00Z01jan2000 1yr
zdef 1 linear 1 1
vars 1
subbsn 1 -1,40,4 Sample subbasin identifier at 30,000 / 5,000 km2 thresholds [1]
ENDVARS
