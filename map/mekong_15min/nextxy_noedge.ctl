dset ^nextxy_noedge.bin
undef -9999
title CaMa-Flood map file nextxy_noedge.bin
options yrev little_endian
xdef 80 linear 90.125 0.25
ydef 120 linear 5.125 0.25
tdef 1 linear 00Z01jan2000 1yr
zdef 1 linear 1 1
vars 2
nextx 1 -1,40,4 Downstream indices without regional edge endpoints
nexty 1 -1,40,4 Downstream indices without regional edge endpoints
ENDVARS
