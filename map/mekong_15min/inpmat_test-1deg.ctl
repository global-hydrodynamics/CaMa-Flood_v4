dset ^inpmat_test-1deg.bin
undef 0
title CaMa-Flood map file inpmat_test-1deg.bin
options yrev little_endian
xdef 80 linear 90.125 0.25
ydef 120 linear 5.125 0.25
tdef 1 linear 00Z01jan2000 1yr
zdef 4 linear 1 1
vars 3
inpx 4 -1,40,4,-1 Input-grid x index (INPN=4)
inpy 4 -1,40,4,-1 Input-grid y index (INPN=4)
inpa 4 99 Overlap area (INPN=4) [m2]
ENDVARS
