dset ^inpmat_test-E2O_15min_nc.bin
undef 0
title CaMa-Flood map file inpmat_test-E2O_15min_nc.bin
options yrev little_endian
xdef 80 linear 90.125 0.25
ydef 120 linear 5.125 0.25
tdef 1 linear 00Z01jan2000 1yr
zdef 10 linear 1 1
vars 3
inpx 10 -1,40,4 Input-grid x index [1]
inpy 10 -1,40,4 Input-grid y index [1]
inpa 10 99 Input-grid overlap area [m2]
ENDVARS
