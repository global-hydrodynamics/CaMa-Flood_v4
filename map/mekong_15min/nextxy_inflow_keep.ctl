dset ^nextxy_inflow_keep.bin
undef -9999
title Flow Direction
options yrev little_endian
xdef     80 linear    90.1250000000000000    0.2500000000000000
ydef    120 linear     5.1250000000000000    0.2500000000000000
tdef 1 linear 00Z01jan2000 1yr
zdef 1 linear 1 1
vars 2
varx   1 -1,40,4,-1 **
vary   1 -1,40,4,-1 **
ENDVARS
